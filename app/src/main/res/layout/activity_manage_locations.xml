<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_saffron">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarLocations"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Registered GPS Locations"
            app:titleTextColor="@color/text_on_saffron"
            app:navigationIcon="@android:drawable/ic_menu_revert" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline EXIF GPS Matching (40m Radius)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/maroon_kumkum" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Photos are saved in Pictures/Dussehra_2026/[Devi_Alankaram]/[Home | Yeendda_Durga_Devi_Temple | Carshed_Bobleam]/. Unmatched, missing GPS, or ambiguous matches automatically go to date subfolder [YYYY-MM-DD]/."
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Test Coordinates Function Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestCoordinates"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Test GPS Matching &amp; Destination Path"
            android:textSize="13sp"
            app:cornerRadius="10dp"
            android:backgroundTint="@color/primary_saffron"
            android:textColor="@color/text_on_saffron"
            app:icon="@android:drawable/ic_menu_mylocation"
            app:iconGravity="textStart"
            android:layout_marginBottom="10dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLocations"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetLocations"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Reset Locations to Defaults"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/maroon_kumkum"
            app:strokeColor="@color/maroon_kumkum"
            app:cornerRadius="10dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
