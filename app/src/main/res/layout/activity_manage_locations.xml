<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_saffron">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarLocations"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Registered Locations"
            app:titleTextColor="@color/text_on_saffron"
            app:navigationIcon="@android:drawable/ic_menu_revert" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline GPS Matching"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/maroon_kumkum" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location matching works 100% offline using EXIF coordinates. Unmatched or GPS-missing photos automatically go to Pictures/Location_Organized/YYYY-MM-DD/."
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLocations"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetLocations"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Reset Locations to Defaults"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:textColor="@color/maroon_kumkum"
            app:strokeColor="@color/maroon_kumkum"
            app:cornerRadius="10dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
