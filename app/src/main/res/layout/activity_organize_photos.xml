<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary_saffron">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarOrganize"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Organize Camera Photos"
            app:titleTextColor="@color/text_on_saffron"
            app:navigationIcon="@android:drawable/ic_menu_revert" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Safety & Filter Notice -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/primary_saffron_light"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@color/cream_surface"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="@string/camera_photos_only_notice"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Status Summary Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvFoundCount"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Found: 0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/select_all"
                android:textSize="12sp"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/maroon_kumkum" />
        </LinearLayout>

        <!-- Progress Indicator -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEligiblePhotos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- Confirm Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmCopy"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/confirm_copy_button"
            android:textSize="15sp"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/primary_saffron"
            android:textColor="@color/text_on_saffron"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
